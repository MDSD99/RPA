# Copy outside version control and provide values through environment/secret management.
# These values are intentionally fake. No .env file is loaded implicitly.
APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=rpa_development
DB_USER=rpa_example_user
DB_PASSWORD=REPLACE_WITH_A_SECRET
DB_SSLMODE=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5
DB_CONNECT_ATTEMPTS=3
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000

# Production: remote private-network host, least-privileged account, verified TLS.
# APP_ENV=production
# DB_HOST=postgres.internal.example
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/run/secrets/postgresql-ca.crt
# Production migrations are denied unless explicitly enabled for that command:
# RPA_ALLOW_PRODUCTION_MIGRATIONS=yes

# Tests: isolated PostgreSQL on loopback; both values must match exactly.
# APP_ENV=test
# DB_NAME=rpa_test_example
# RPA_TEST_DB_CONFIRM=rpa_test_example

# Visual browser steps: exact approved public HTTPS hosts; blank disables network targets.
RPA_BROWSER_ALLOWED_HOSTS=
# Example only: RPA_BROWSER_ALLOWED_HOSTS=portal.example.com,static.example.com

# Customer portal settings belong in a SEPARATE private .env.portal file.
# Generate its encryption key with: .venv/bin/python scripts/portal.py init
# See docs/IDENTITY_ONBOARDING.md for MULTIRPA_PUBLIC_URL and MULTIRPA_SMTP_*.
# Do not put MULTIRPA_* keys into the management console's .env file.
